# Copy to .env and fill in real values. Never commit the real .env file.
# Long random string, at least 32 characters.
JWT_SECRET=replace-this-with-a-long-random-secret
# How long a session token stays valid (e.g. 12h, 1d, 7d).
JWT_EXPIRES_IN=1d
API_PORT=3001
DATABASE_PATH=./data/shops.sqlite
# Comma-separated emails allowed to reach /api/admin/*
ADMIN_EMAILS=you@example.com
GOOGLE_CLIENT_ID=replace-this-with-google-client-id
# Comma-separated browser origins allowed to call the API directly (your Vercel domain).
ALLOWED_ORIGINS=http://localhost:5173
